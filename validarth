valari.l
%{
#include "y.tab.h"
%}

%%
[a-zA-Z_][a-zA-Z0-9_]* { return ID; }
[0-9]+                 { return NUMBER; }
[ \t]+                 { /* Ignore whitespace */ }
\n                     { return 0; }
.                      { return yytext[0]; }
%%

int yywrap() 
{
    return 1;
}

valari.y
%{
#include <stdio.h>
#include <stdlib.h>
int yylex();
void yyerror(const char *s);
%}

%token ID NUMBER
%left '+' '-'
%left '*' '/'

%%
stmt: expr { printf("\nValid Expression\n"); exit(0); }
    ;

expr: expr '+' expr
    | expr '-' expr
    | expr '*' expr
    | expr '/' expr
    | '(' expr ')'
    | ID
    | NUMBER
    ;
%%

int main() 
{
    printf("\nEnter an expression (e.g., a+b*c):\n");
    yyparse();
    return 0;
}

void yyerror(const char *s) 
{
    printf("\nInvalid expression\n");
    exit(1);
}
