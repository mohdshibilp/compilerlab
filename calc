calc.y
%{
#include <stdio.h>
#include <stdlib.h>
int yylex();
void yyerror(const char *s);
int flag = 0;
%}

%token NUMBER
%left '+' '-'
%left '*' '/' '%'

%%
ArithematicExpression: E { 
                           printf("\nResult = %d\n", $1); 
                           return 0; 
                         }
                     ;

E: E '+' E { $$ = $1 + $3; }
 | E '-' E { $$ = $1 - $3; }
 | E '*' E { $$ = $1 * $3; }
 | E '/' E { $$ = $1 / $3; }
 | E '%' E { $$ = $1 % $3; }
 | '(' E ')' { $$ = $2; }
 | NUMBER    { $$ = $1; }
 ;
%%

int main() 
{
    printf("\nEnter any arithmetic expression (e.g., 3+5): \n");
    yyparse();
    if (flag == 0)
        printf("\nEntered arithmetic expression is valid \n\n");
    return 0;
}

void yyerror(const char *s) 
{
    printf("\nEntered arithmetic expression is invalid \n\n");
    flag = 1;
}
